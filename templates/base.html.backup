{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{% endblock %}</title>

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Bootstrap Core CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{% static 'css/custom-buttons.css' %}">
  <link rel="stylesheet" href="{% static 'css/base.css' %}">

  <!-- Favicon (SVG + PNG fallback) -->
  <link rel="icon" href="{% static 'icons/favicon.svg' %}" type="image/svg+xml">
  <link rel="icon" href="{% static 'icons/favicon.png' %}" type="image/png">

  {% block extra_css %}{% endblock %}
</head>
<body class="{% if user.is_authenticated %}{{ user.role|lower }}{% endif %}">

<!-- Navbar -->
{% block navbar %}
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{% url 'home' %}">
  <img src="https://i.postimg.cc/6y1ZG0hj/SHREE-PARTH-ACADEMY-84-x-44.png" alt="Shree Parth Academy" height="44" class="me-2">
  Shree Parth Academy
</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                {% if user.is_authenticated %}
                    <li class="nav-item dropdown">
                        <a class="d-flex align-items-center text-decoration-none" href="{% url 'profile' %}">
                            {% if user.profile_photo %}
                              <img src="{{ user.profile_photo.url }}" alt="avatar" class="avatar-40">
                            {% else %}
                              <div class="avatar-fallback-40">
                                {{ user.get_full_name|default:user.username|slice:':1'|upper }}
                              </div>
                            {% endif %}
                        </a>
                    </li>
                    <li class="nav-item ms-2"><a class="nav-link" href="{% url 'logout' %}">Logout</a></li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{% url 'login' %}">Login</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endblock %}

<!-- Alerts -->
{% if messages %}
  <div class="container mt-3">
    {% for m in messages %}
      <div class="alert alert-{{ m.tags }} fade show" role="alert">
        {{ m }}
      </div>
    {% endfor %}
  </div>
{% endif %}

<!-- Main Content -->
<div class="container mt-4 mb-5">
    {% block content %}{% endblock %}
</div>

<!-- Footer -->
<footer class="bg-dark text-light pt-4 pb-3">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <h5>Shree Parth Academy</h5>
        <p class="mb-0">✦ AN EMPEROR OF KNOWLEDGE ✦</p>
        <p>We strive for our student's success</p>
        <p class="mb-0">Established: 2009</p>
        <p class="mb-0">Founder: Mr. Swapnil Kalaskar</p>
      </div>
      <div class="col-md-4">
        <h5>Contact</h5>
        <p class="mb-0">📞 +91 9011395913, +91 9221838267</p>
        <p class="mb-0">✉️ shreeparthacademy2009@gmail.com</p>
        <p>📍 Ground Floor, Tryambak Heaven 2, Beside Holy Spirit High School, Surval Chowk, MIDC Shirgaon, Badlapur (E), Maharashtra 421503</p>
      </div>
      <div class="col-md-4">
        <h5>Follow Us</h5>
        <a href="https://t.me/ShreeParthAcademy" target="_blank" class="text-light me-2">Telegram</a>
        <a href="https://instagram.com/shreeparthacademy" target="_blank" class="text-light me-2">Instagram</a>
        <a href="https://facebook.com/shreeparthacademy" target="_blank" class="text-light">Facebook</a>
        <p class="mt-2 mb-0">UPI: shreeparthacademy2009-2@okaxis</p>
      </div>
    </div>
    <div class="text-center mt-3">
      &copy; {% now "Y" %} Shree Parth Academy. All rights reserved.
    </div>
  </div>
</footer>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
{% block extra_js %}{% endblock %}
</body>
</html>
