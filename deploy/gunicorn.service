[Unit]
Description=Scholaroid Gunicorn Service
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/spacms
ExecStart=/home/ubuntu/spacms/venv/bin/gunicorn managementProject.wsgi:application --bind 0.0.0.0:8000 --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
